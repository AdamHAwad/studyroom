{
  "name": "studyroom",
  "version": "1.0.0",
  "description": "A forever-free, local Quizlet alternative that turns your course materials into study sets with your existing AI subscription",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test \"tests/*.test.ts\"",
    "data": "tsx scripts/data.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "install-startup": "node scripts/install-startup.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "express": "^5.1.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "motion": "^12.35.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
